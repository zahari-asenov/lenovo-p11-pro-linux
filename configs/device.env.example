# Root-owned /etc/j706f-device.conf example for optional installed helpers.
# Populate values from the actual existing installation; never guess or commit them.
J706F_SERIAL='CONFIGURE_DEVICE_SERIAL'
J706F_ROOT_ID='CONFIGURE_EXISTING_ROOT_MARKER'
J706F_STORAGE_PARTUUID='CONFIGURE_EXISTING_STORAGE_UUID'
